POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
MCP_API_KEY=
# Basic Auth for /dashboard and /api/admin/* (Caddy). Generate the hash with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext '<password>'
# Docker Compose interpolates `$` in .env values itself -- double every `$`
# in the hash (bcrypt hashes are full of them) to `$$` or it gets silently
# corrupted before it ever reaches the container. See docs/incidents.md.
ADMIN_BASIC_AUTH_USER=
ADMIN_BASIC_AUTH_HASH=
