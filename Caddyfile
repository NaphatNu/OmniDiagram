:80 {
	# Backend-internal conversion routes must never be reachable from outside.
	handle /api/internal/* {
		respond 404
	}

	# Dashboard and admin API are the only things behind a login; everything else is public.
	handle /api/admin/* {
		basic_auth {
			{$ADMIN_BASIC_AUTH_USER} {$ADMIN_BASIC_AUTH_HASH}
		}
		reverse_proxy backend:8080
	}

	handle /api/* {
		reverse_proxy backend:8080
	}

	handle /mcp {
		reverse_proxy backend:8080
	}

	handle /mcp/* {
		reverse_proxy backend:8080
	}

	handle /dashboard {
		basic_auth {
			{$ADMIN_BASIC_AUTH_USER} {$ADMIN_BASIC_AUTH_HASH}
		}
		reverse_proxy frontend:3000
	}

	handle /dashboard/* {
		basic_auth {
			{$ADMIN_BASIC_AUTH_USER} {$ADMIN_BASIC_AUTH_HASH}
		}
		reverse_proxy frontend:3000
	}

	handle {
		reverse_proxy frontend:3000
	}
}
